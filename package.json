{
  "name": "todash",
  "version": "0.1.0",
  "description": "Governance, routing, observability and cost-attribution for Cursor.",
  "type": "module",
  "bin": {
    "todash": "./bin/todash.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build --config web/vite.config.ts",
    "dev": "concurrently -k \"tsx watch src/cli.ts serve --port 4780\" \"vite --config web/vite.config.ts\"",
    "serve": "tsx src/cli.ts serve",
    "todash": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "better-sqlite3": "^12.2.0",
    "hono": "^4.9.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "concurrently": "^9.2.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
